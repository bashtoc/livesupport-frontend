NODE_ENV=development
PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
TRUST_PROXY=loopback,linklocal,uniquelocal
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://safer_support:change-me@postgres:5432/safer_support
REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_ISSUER=safer-support
PRIMARY_APP_ISSUER=safer-primary
PRIMARY_APP_AUDIENCE=safer-support
# PEM-encoded Ed25519 public key. Use literal \n characters in a one-line env value.
PRIMARY_APP_PUBLIC_KEY=
CUSTOMER_ACCESS_TTL=15m
STAFF_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=safer-support-private
R2_PRESIGN_TTL_SECONDS=300
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_ACCOUNT_ID=
EMAIL_FROM=support@saference.com
SUPPORT_APP_URL=https://support.saference.com
MAX_ATTACHMENT_BYTES=10485760
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.saferai.com.ai
# PEM-encoded APNs .p8 key. Use literal \n characters in a one-line env value.
APNS_PRIVATE_KEY=
# Optional Google service-account JSON for Android FCM delivery.
FCM_SERVICE_ACCOUNT_JSON=
METRICS_TOKEN=
LOG_LEVEL=info
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
